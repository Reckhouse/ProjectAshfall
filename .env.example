# Local / CI can use PGlite. Vercel production/preview must use the Neon pooled URL.
DATABASE_URL=pglite:.data/ashfall.db

# Required in Vercel production and preview. Min 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret-value

# Public origin for the deployment, e.g. https://your-app.vercel.app
APP_ORIGIN=http://localhost:3000

# Optional override for the server-only world seed written on first seed.
# WORLD_SEED=
